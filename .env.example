# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
RAW_EVENTS_TOPIC=livepulse.raw.v1
AGG_EVENTS_TOPIC=livepulse.agg.v1
FANOUT_TOPIC=livepulse.fanout.v1

# ---- Ingest API ----
API_HOST=0.0.0.0
API_PORT=5000
PRODUCER_FLUSH_INTERVAL_SEC=0.5
PRODUCER_QUEUE_MAX=50000

# ---- Streaming ----
WINDOW_SECONDS=2
DOWNSAMPLE_PER_UNIT=1000
SPARK_CHECKPOINT_DIR=/tmp/livepulse-checkpoint
SPARK_APP_NAME=LivePulseKafkaSparkAggregator

# ---- Fan-out ----
MAIN_PUBLISHER_FLUSH_SEC=0.5
WS_HOST=localhost
WS_PORT=8765

# ---- Demo ----
API_BASE_URL=http://localhost:5000
